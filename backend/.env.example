APP_NAME=FocusAI
ENVIRONMENT=development

# Database. Leave this line commented out to use a local SQLite file (no setup needed).
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# AI reviewer (Google Gemini). Leave the key empty to run without the LLM.
LLM_PROVIDER=gemini
LLM_API_KEY=

# Login tokens. Generate a value with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=